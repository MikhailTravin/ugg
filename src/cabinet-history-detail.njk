<!DOCTYPE html>
<html lang="ru">

<head>
    <title>Личный кабинет - история (детализация заказа)</title>
    {% include 'blocks/head.njk' %}
</head>

<body class="preload mp">
    <div class="main-wrapper-outer">
        {% include 'blocks/header.njk' %}
        <main class="main">

            <div class="breadcrumbs">
                <div class="container">
                    <ul>
                        <li>
                            <a href="#" class="home">
                                <svg aria-hidden="true" width="16" height="14">
                                    <use xlink:href="img/sprite.svg#home"></use>
                                </svg>
                            </a>
                        </li>
                        <li>
                            <a href="./">Личный кабинет</a>
                        </li>
                        <li><span>История заказов</span></li>
                    </ul>
                </div>
            </div>

            <div class="block-cabinet">
                <div class="container">
                    <div class="block-cabinet__content">
                        <div class="block-cabinet-menu">
                            <div class="block-cabinet-menu__top">
                                <div class="block-cabinet-menu__name">
                                    Здравствуйте,<br> Александр Иванович
                                </div>
                                <p>
                                    Добро пожаловать в ваш личный кабинет
                                </p>
                            </div>
                            <ul>
                                <li>
                                    <a href="./">
                                        <div class="block-cabinet-menu__icon">
                                            <svg aria-hidden="true" width="18" height="18">
                                                <use xlink:href="img/sprite.svg#user"></use>
                                            </svg>
                                        </div>
                                        <span>Мой профиль</span>
                                    </a>
                                </li>
                                <li>
                                    <a href="./" class="active">
                                        <div class="block-cabinet-menu__icon">
                                            <svg aria-hidden="true" width="20" height="18">
                                                <use xlink:href="img/sprite.svg#history"></use>
                                            </svg>
                                        </div>
                                        <span>История заказов</span>
                                    </a>
                                </li>
                                <li>
                                    <a href="./">
                                        <div class="block-cabinet-menu__icon">
                                            <svg aria-hidden="true" width="20" height="20">
                                                <use xlink:href="img/sprite.svg#map2"></use>
                                            </svg>
                                        </div>
                                        <span>Мои адреса</span>
                                    </a>
                                </li>
                                <li>
                                    <a href="./">
                                        <div class="block-cabinet-menu__icon">
                                            <svg aria-hidden="true" width="18" height="17">
                                                <use xlink:href="img/sprite.svg#heart"></use>
                                            </svg>
                                        </div>
                                        <span>Избранное</span>
                                    </a>
                                </li>
                                <li>
                                    <a href="./">
                                        <div class="block-cabinet-menu__icon">
                                            <svg aria-hidden="true" width="16" height="20">
                                                <use xlink:href="img/sprite.svg#password"></use>
                                            </svg>
                                        </div>
                                        <span>Смена пароля</span>
                                    </a>
                                </li>
                                <li>
                                    <a href="./">
                                        <div class="block-cabinet-menu__icon">
                                            <svg aria-hidden="true" width="18" height="17">
                                                <use xlink:href="img/sprite.svg#news"></use>
                                            </svg>
                                        </div>
                                        <span>Подписка на новости</span>
                                    </a>
                                </li>
                            </ul>
                            <a href="./" class="btn btn-blue-border">Выйти</a>
                        </div>
                        <div class="block-cabinet__body">
                            <div class="block-cabinet__top">
                                <h1 class="title1">
                                    Ваш заказ отправлен
                                </h1>
                            </div>
                            <div class="block-history-detail">
                                <div class="block-history-detail__number">
                                    <div class="block-history-detail__text">
                                        <span>Трек-номер для отслеживания:</span> 1234567890
                                    </div>
                                    <a href="./" class="btn btn-blue-border">
                                        Отследить на сайте СДЭК
                                    </a>
                                </div>
                                <div class="block-history-detail__body">
                                    <div class="block-cart__table">
                                        <div class="block-cart__titles">
                                            <div class="block-cart__left">
                                                <div class="block-cart__name">Товар</div>
                                            </div>
                                            <div class="block-cart__right">
                                                <div class="block-cart__name">Кол-во</div>
                                                <div class="block-cart__name">Цена</div>
                                                <div class="block-cart__name">Итого</div>
                                            </div>
                                        </div>
                                        <div class="block-cart__cards">
                                            <div class="card-cart">
                                                <div class="card-cart__left">
                                                    <a href="./" class="card-cart__image">
                                                        <img loading="lazy" src="img/products/image5.webp" alt="">
                                                    </a>
                                                    <div class="card-cart__item">
                                                        <div class="card-cart__top">
                                                            <a href="./" class="card-cart__title">
                                                                UGG Lowmel Lo Campfire
                                                            </a>
                                                            <div class="card-cart__buttons">
                                                                <div class="card-cart__price">
                                                                    8 990 ₽
                                                                </div>
                                                                <div class="card-cart__button">
                                                                    <span>Размер:</span> 37
                                                                </div>
                                                                <div class="card-cart__button">
                                                                    <span>Цвет:</span> Песочный
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="card-cart__right">
                                                            <div class="quantity">
                                                                <p>1</p>
                                                            </div>
                                                            <div class="card-cart__total">
                                                                <div class="card-cart__sum">8 990 ₽</div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="card-cart__right">
                                                    <div class="quantity">
                                                        <p>
                                                            1
                                                        </p>
                                                    </div>
                                                    <div class="card-cart__price">
                                                        8 990 ₽
                                                    </div>
                                                    <div class="card-cart__total">
                                                        <div class="card-cart__sum">8 990 ₽</div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="card-cart">
                                                <div class="card-cart__left">
                                                    <a href="./" class="card-cart__image">
                                                        <img loading="lazy" src="img/products/image6.webp" alt="">
                                                    </a>
                                                    <div class="card-cart__item">
                                                        <div class="card-cart__top">
                                                            <a href="./" class="card-cart__title">
                                                                UGG Goldenstar Clog Sand
                                                            </a>
                                                            <div class="card-cart__buttons">
                                                                <div class="card-cart__price">
                                                                    7 450 ₽
                                                                </div>
                                                                <div class="card-cart__button">
                                                                    <span>Размер:</span> 40
                                                                </div>
                                                                <div class="card-cart__button">
                                                                    <span>Цвет:</span> Серый
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <div class="card-cart__right">
                                                            <div class="quantity">
                                                                <p>2</p>
                                                            </div>
                                                            <div class="card-cart__total">
                                                                <div class="card-cart__sum">14 900 ₽</div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="card-cart__right">
                                                    <div class="quantity">
                                                        <p>2</p>
                                                    </div>
                                                    <div class="card-cart__price">
                                                        7 450 ₽
                                                    </div>
                                                    <div class="card-cart__total">
                                                        <div class="card-cart__sum">14 900 ₽</div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="block-order-detail">
                                        <div class="block-order-detail__column">
                                            <div class="block-order-detail__top">
                                                <div class="block-order-detail__icon">
                                                    <svg aria-hidden="true" width="24" height="24">
                                                        <use xlink:href="img/sprite.svg#delivery"></use>
                                                    </svg>
                                                </div>
                                                <div class="block-order-detail__title">
                                                    Доставка
                                                </div>
                                            </div>
                                            <ul>
                                                <li>
                                                    <div class="block-order-detail__name">
                                                        Способ доставки
                                                    </div>
                                                    <div class="block-order-detail__line"></div>
                                                    <div class="block-order-detail__value">
                                                        СДЭК (Пункт выдачи)
                                                    </div>
                                                </li>
                                                <li>
                                                    <div class="block-order-detail__name">
                                                        Адрес получения
                                                    </div>
                                                    <div class="block-order-detail__line"></div>
                                                    <div class="block-order-detail__value">
                                                        г. Москва, ул. Ленина, д. 10
                                                    </div>
                                                </li>
                                                <li>
                                                    <div class="block-order-detail__name">
                                                        Получатель
                                                    </div>
                                                    <div class="block-order-detail__line"></div>
                                                    <div class="block-order-detail__value">
                                                        Иван Иванов, +7 (999) 000-00-00
                                                    </div>
                                                </li>
                                            </ul>
                                        </div>
                                        <div class="block-order-detail__column">
                                            <div class="block-order-detail__top">
                                                <div class="block-order-detail__icon">
                                                    <svg aria-hidden="true" width="22" height="22">
                                                        <use xlink:href="img/sprite.svg#wallet"></use>
                                                    </svg>
                                                </div>
                                                <div class="block-order-detail__title">
                                                    Оплата
                                                </div>
                                            </div>
                                            <ul>
                                                <li>
                                                    <div class="block-order-detail__name">
                                                        Способ доставки
                                                    </div>
                                                    <div class="block-order-detail__line"></div>
                                                    <div class="block-order-detail__value">
                                                        При получении картой
                                                    </div>
                                                </li>
                                                <li>
                                                    <div class="block-order-detail__name">
                                                        Сумма товаров
                                                    </div>
                                                    <div class="block-order-detail__line"></div>
                                                    <div class="block-order-detail__value">
                                                        32 000 ₽
                                                    </div>
                                                </li>
                                                <li>
                                                    <div class="block-order-detail__name">
                                                        Стоимость доставки
                                                    </div>
                                                    <div class="block-order-detail__line"></div>
                                                    <div class="block-order-detail__value">
                                                        500 ₽
                                                    </div>
                                                </li>
                                                <li>
                                                    <div class="block-order-detail__name">
                                                        <span>Итого к оплате</span>
                                                    </div>
                                                    <div class="block-order-detail__line"></div>
                                                    <div class="block-order-detail__value">
                                                        <span>32 500 ₽</span>
                                                    </div>
                                                </li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                                <div class="block-history-detail__buttons">
                                    <a href="./" class="btn btn-grey">Вернуться к списку заказов</a>
                                    <a href="./" class="btn">Повторить заказ</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </main>
        {% include 'blocks/footer.njk' %}
    </div>
    {% include 'blocks/scripts.njk' %}
</body>

</html>