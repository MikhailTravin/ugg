<!DOCTYPE html>
<html lang="ru">

<head>
    <title>Оформление заказа4</title>
    {% include 'blocks/head.njk' %}
</head>

<body class="preload mp">
    <div class="main-wrapper-outer">
        {% include 'blocks/header.njk' %}
        <main class="main">

            <div class="block-order">
                <div class="container">
                    <a href="./" class="back">
                        <div class="back__arrow">
                            <svg aria-hidden="true" width="10" height="15">
                                <use xlink:href="img/sprite.svg#arrow1"></use>
                            </svg>
                        </div>
                        <span>Вернуться в корзину</span>
                    </a>
                    <div class="block-order__top">
                        <h1 class="title1">Оформление заказа</h1>
                        <div class="block-order__steps">
                            <div class="block-order__step filled">
                                <div class="block-order__icon">
                                    <svg aria-hidden="true" width="16" height="14">
                                        <use xlink:href="img/sprite.svg#check1"></use>
                                    </svg>
                                </div>
                                <div class="block-order__title">
                                    Вход
                                </div>
                                <div class="block-order__line"></div>
                            </div>
                            <div class="block-order__step filled">
                                <div class="block-order__icon">
                                    <svg aria-hidden="true" width="16" height="14">
                                        <use xlink:href="img/sprite.svg#check1"></use>
                                    </svg>
                                </div>
                                <div class="block-order__title">
                                    Контакты
                                </div>
                                <div class="block-order__line"></div>
                            </div>
                            <div class="block-order__step filled">
                                <div class="block-order__icon">
                                    <svg aria-hidden="true" width="16" height="14">
                                        <use xlink:href="img/sprite.svg#check1"></use>
                                    </svg>
                                </div>
                                <div class="block-order__title">
                                    Адрес
                                </div>
                                <div class="block-order__line"></div>
                            </div>
                            <div class="block-order__step active">
                                <div class="block-order__icon">
                                    4
                                </div>
                                <div class="block-order__title">
                                    Доставка
                                </div>
                                <div class="block-order__line"></div>
                            </div>
                            <div class="block-order__step">
                                <div class="block-order__icon">
                                    5
                                </div>
                                <div class="block-order__title">
                                    Оплата
                                </div>
                                <div class="block-order__line"></div>
                            </div>
                            <div class="block-order__step">
                                <div class="block-order__icon">
                                    6
                                </div>
                                <div class="block-order__title">
                                    Подтверждение
                                </div>
                            </div>
                        </div>
                    </div>
                    <form action="#" class="block-order__content">
                        <div class="block-order__titles">
                            <div class="title3">
                                Способ доставки
                            </div>
                            <p>
                                Варианты доставки СДЭК для города <span>Москва</span>
                            </p>
                        </div>
                        <div class="block-order__body">
                            <div class="options">
                                <label class="options__item">
                                    <input checked hidden class="options__input" type="radio" value="1" name="option">
                                    <span class="options__label">
                                        <span class="options__icon">
                                            <svg aria-hidden="true" width="24" height="24">
                                                <use xlink:href="img/sprite.svg#delivery"></use>
                                            </svg>
                                        </span>
                                        <span class="options__text">
                                            <span class="options__title">
                                                СДЭК Экспресс
                                            </span>
                                            <span class="options__price">
                                                <span class="options__time">2-3 дня</span>
                                                <span class="options__sum">450 ₽</span>
                                            </span>
                                            <p>
                                                Курьерская доставка до двери
                                            </p>
                                        </span>
                                        <span class="options__check"></span>
                                </label>
                                <label class="options__item">
                                    <input hidden class="options__input" type="radio" value="2" name="option">
                                    <span class="options__label">
                                        <span class="options__icon">
                                            <svg aria-hidden="true" width="24" height="24">
                                                <use xlink:href="img/sprite.svg#delivery"></use>
                                            </svg>
                                        </span>
                                        <span class="options__text">
                                            <span class="options__title">
                                                СДЭК Стандарт
                                            </span>
                                            <span class="options__price">
                                                <span class="options__time">4-6 дней</span>
                                                <span class="options__sum">290 ₽</span>
                                            </span>
                                            <p>
                                                Курьерская доставка до двери
                                            </p>
                                        </span>
                                        <span class="options__check"></span>
                                </label>
                                <label class="options__item">
                                    <input hidden class="options__input" type="radio" value="3" name="option">
                                    <span class="options__label">
                                        <span class="options__icon">
                                            <svg aria-hidden="true" width="18" height="22">
                                                <use xlink:href="img/sprite.svg#map1"></use>
                                            </svg>
                                        </span>
                                        <span class="options__text">
                                            <span class="options__title">
                                                СДЭК до ПВЗ
                                            </span>
                                            <span class="options__price">
                                                <span class="options__time">3-5 дней</span>
                                                <span class="options__sum">190 ₽</span>
                                            </span>
                                            <p>
                                                Доставка до пункта выдачи
                                            </p>
                                        </span>
                                        <span class="options__check"></span>
                                </label>
                            </div>
                        </div>
                        <div class="block-order__buttons">
                            <a href="./" class="btn btn-white">Назад</a>
                            <button type="submit" class="btn">Продолжить</button>
                        </div>
                    </form>
                </div>
            </div>

        </main>
        {% include 'blocks/footer.njk' %}
    </div>
    {% include 'blocks/scripts.njk' %}
</body>

</html>