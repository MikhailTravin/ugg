<!DOCTYPE html>
<html lang="ru">

<head>
    <title>Оформление заказа3</title>
    {% include 'blocks/head.njk' %}
</head>

<body class="preload mp">
    <div class="main-wrapper-outer">
        {% include 'blocks/header.njk' %}
        <main class="main">

            <div class="block-order">
                <div class="container">
                    <a href="./" class="back">
                        <div class="back__arrow">
                            <svg aria-hidden="true" width="10" height="15">
                                <use xlink:href="img/sprite.svg#arrow1"></use>
                            </svg>
                        </div>
                        <span>Вернуться в корзину</span>
                    </a>
                    <div class="block-order__top">
                        <h1 class="title1">Оформление заказа</h1>
                        <div class="block-order__steps">
                            <div class="block-order__step filled">
                                <div class="block-order__icon">
                                    <svg aria-hidden="true" width="16" height="14">
                                        <use xlink:href="img/sprite.svg#check1"></use>
                                    </svg>
                                </div>
                                <div class="block-order__title">
                                    Вход
                                </div>
                                <div class="block-order__line"></div>
                            </div>
                            <div class="block-order__step filled">
                                <div class="block-order__icon">
                                    <svg aria-hidden="true" width="16" height="14">
                                        <use xlink:href="img/sprite.svg#check1"></use>
                                    </svg>
                                </div>
                                <div class="block-order__title">
                                    Контакты
                                </div>
                                <div class="block-order__line"></div>
                            </div>
                            <div class="block-order__step active">
                                <div class="block-order__icon">
                                    3
                                </div>
                                <div class="block-order__title">
                                    Адрес
                                </div>
                                <div class="block-order__line"></div>
                            </div>
                            <div class="block-order__step">
                                <div class="block-order__icon">
                                    4
                                </div>
                                <div class="block-order__title">
                                    Доставка
                                </div>
                                <div class="block-order__line"></div>
                            </div>
                            <div class="block-order__step">
                                <div class="block-order__icon">
                                    5
                                </div>
                                <div class="block-order__title">
                                    Оплата
                                </div>
                                <div class="block-order__line"></div>
                            </div>
                            <div class="block-order__step">
                                <div class="block-order__icon">
                                    6
                                </div>
                                <div class="block-order__title">
                                    Подтверждение
                                </div>
                            </div>
                        </div>
                    </div>
                    <form action="#" class="block-order__content">
                        <div class="block-order__titles">
                            <div class="title3">
                                Адрес доставки
                            </div>
                            <p>
                                Укажите адрес, куда нужно доставить заказ
                            </p>
                        </div>
                        <div class="block-order__body">
                            <div class="form">
                                <div class="form__body">
                                    <label class="checkbox4">
                                        <input hidden class="checkbox4__input options-address" type="checkbox" value="1"
                                            name="checkbox">
                                        <span class="checkbox4__label">
                                            <span class="checkbox4__check"></span>
                                            <span class="checkbox4__text">Мой адрес доставки совпадает с
                                                платёжным</span>
                                        </span>
                                    </label>
                                    <div class="form__inputs form-inputs-grid2">
                                        <div class="form__input">
                                            <label for="street1">Улица <span>*</span></label>
                                            <input id="street1" data-required autocomplete="off" type="text"
                                                name="form[]" placeholder="ул. Ленина" class="input">
                                        </div>
                                        <div class="form__input">
                                            <label for="dom1">Дом <span>*</span></label>
                                            <input id="dom1" data-required autocomplete="off" type="text" name="form[]"
                                                placeholder="12" class="input">
                                        </div>
                                        <div class="form__input">
                                            <label for="kvartira1">Квартира</label>
                                            <input id="kvartira1" data-required autocomplete="off" type="text"
                                                name="form[]" placeholder="45" class="input">
                                        </div>
                                        <div class="form__input">
                                            <label for="index1">Индекс <span>*</span></label>
                                            <input id="index1" data-required autocomplete="off" type="text"
                                                name="form[]" placeholder="101000" class="input">
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="block-order__buttons">
                            <a href="./" class="btn btn-white">Назад</a>
                            <button type="submit" class="btn">Продолжить</button>
                        </div>
                    </form>
                </div>
            </div>

        </main>
        {% include 'blocks/footer.njk' %}
    </div>
    {% include 'blocks/scripts.njk' %}
</body>

</html>